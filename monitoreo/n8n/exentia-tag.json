        "jsCode": "// Recibe { contact_id, tag, action: 'add'|'remove' }\nlet body = $input.item.json.body || $input.item.json;\nif (typeof body === 'string') { try { body = JSON.parse(body); } catch(e) { body = {}; } }\nbody = body || {};\n\nconst contact_id = body.contact_id || body.contactId || null;\nconst tag = (body.tag || '').toLowerCase().trim();\nconst action = (body.action || 'add').toLowerCase();\n\nconst ALLOWED_TAGS = ['asistio', 'no_asistio', 'no-show', 'cancelado_cliente', 'pago', 'pagado'];\n\nif (!contact_id) return { json: { valid: false, error: 'contact_id missing' } };\nif (!tag) return { json: { valid: false, error: 'tag missing' } };\nif (ALLOWED_TAGS.indexOf(tag) === -1) return { json: { valid: false, error: 'tag not allowed: ' + tag } };\nif (['add','remove'].indexOf(action) === -1) return { json: { valid: false, error: 'invalid action' } };\n\nreturn { json: { valid: true, contact_id, tag, action } };"
      },
